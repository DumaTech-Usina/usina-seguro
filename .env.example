# Runtime environment: development | test | production
NODE_ENV=development

# Port and host of the single HTTP process
PORT=3000
HOST=127.0.0.1

# Where people reach the system (base of the links sent by e-mail).
# Defaults to http://HOST:PORT. In staging/production, the https address.
APP_BASE_URL=

# Persistence driver: memory | sqlite | postgres
PERSISTENCE_DRIVER=sqlite

# Used only when PERSISTENCE_DRIVER=sqlite. ':memory:' is accepted.
SQLITE_FILE=./data/usina.sqlite

# Used only when PERSISTENCE_DRIVER=postgres (not implemented yet)
DATABASE_URL=

# E-mail of access (invitation, password reset). With SMTP_HOST set the driver is
# smtp; without it, e-mails are written to the server output (driver log).
# EMAIL_DRIVER=smtp|log|memory
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (465); false uses STARTTLS when offered (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
