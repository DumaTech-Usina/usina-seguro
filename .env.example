# =============================================================================
# Usina do Seguro — configuração por variáveis de ambiente
#
# Copie para .env e preencha. O .env nunca vai para o git nem para a imagem.
# Os valores abaixo são exemplos: nenhum deles é uma credencial real.
#
# [PRODUÇÃO: obrigatória]  a aplicação não inicia sem ela com NODE_ENV=production
# [PRODUÇÃO: necessária]   necessária para a função funcionar em produção
# [opcional]               tem um padrão seguro
# =============================================================================


# --- Ambiente e rede ----------------------------------------------------------

# [PRODUÇÃO: obrigatória] development | test | production.
# production liga o cookie de sessão só por https e exige APP_BASE_URL https.
NODE_ENV=development

# [opcional] Porta em que a aplicação escuta. No Docker, também é a porta
# publicada no servidor (compose.yaml), para onde o nginx encaminha. Padrão 3000.
PORT=3000

# [opcional] Interface em que a aplicação escuta. Padrão 127.0.0.1.
# No Docker é fixada em 0.0.0.0 dentro do container (compose.yaml), e esta
# linha não tem efeito.
HOST=127.0.0.1

# [opcional, só Docker] Endereço do servidor em que a porta é publicada: lida
# pelo docker compose, não pela aplicação. 127.0.0.1 quando o nginx roda no
# mesmo servidor (nada de fora alcança a porta). O IP da rede local do servidor
# (ex.: 192.168.0.10) quando o nginx roda em outra máquina da rede. Nunca
# 0.0.0.0 em um servidor exposto à internet.
BIND_ADDRESS=127.0.0.1

# [PRODUÇÃO: obrigatória] Endereço https pelo qual as pessoas acessam o sistema,
# sem barra no final: é a base dos links dos e-mails de convite e de
# redefinição de senha (/app/invitation/ e /app/password-reset/). Deve ser o
# mesmo domínio que o nginx atende. Em desenvolvimento, vazio = http://HOST:PORT.
APP_BASE_URL=
# APP_BASE_URL=https://sistema.usina.example


# --- Banco de dados -----------------------------------------------------------

# [opcional] memory | sqlite | postgres. Padrão sqlite.
# postgres ainda não está implementado: a aplicação recusa iniciar com ele.
PERSISTENCE_DRIVER=sqlite

# [opcional] Arquivo do banco SQLite. No Docker é fixado em /data/usina.sqlite,
# no volume (compose.yaml). ':memory:' é aceito (nada é guardado).
SQLITE_FILE=./data/usina.sqlite

# [não implementado] Usado só com PERSISTENCE_DRIVER=postgres.
DATABASE_URL=


# --- Armazenamento dos PDFs (propostas e apólices) ----------------------------

# [opcional] database | r2. Padrão database: os PDFs ficam no arquivo SQLite.
# r2: os bytes vão para um bucket privado do Cloudflare R2 (API S3); nome e
# tipo continuam no SQLite. Os downloads sempre passam pelo servidor, depois do
# login: o bucket não precisa nem deve ser público. PDFs guardados antes de
# ligar o R2 continuam sendo lidos do banco; nada é migrado nem apagado.
# Verifique com: npm run storage-check  (ou -- --write para gravar e ler um objeto)
DOCUMENT_STORAGE=database

# [PRODUÇÃO: necessária com DOCUMENT_STORAGE=r2] Endpoint S3 da conta, sem o
# bucket: https://<ID da conta>.r2.cloudflarestorage.com
R2_ENDPOINT=
# R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com

# [PRODUÇÃO: necessária com DOCUMENT_STORAGE=r2] Nome do bucket.
R2_BUCKET=
# R2_BUCKET=usina-documentos

# [PRODUÇÃO: necessária com DOCUMENT_STORAGE=r2] Token de API do R2 com
# permissão "Object Read & Write" restrita a este bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# [opcional] Região da assinatura. O R2 usa "auto" (padrão).
R2_REGION=auto


# --- E-mail de acesso (convite e redefinição de senha) ------------------------

# [opcional] smtp | log | memory. Sem definir: smtp quando SMTP_HOST existe,
# senão log. log não envia nada: escreve o e-mail na saída do servidor (com o
# link!) e devolve o link do convite ao administrador. memory é só para testes.
# Verifique com: npm run smtp-check  (ou -- --to=<e-mail> para enviar um teste)
# EMAIL_DRIVER=smtp

# [PRODUÇÃO: necessária] Servidor SMTP da Usina.
SMTP_HOST=
# SMTP_HOST=smtp.usina.example

# [opcional] Porta. Padrão 587. Use o que o servidor da Usina oferece:
# 587 (submissão com STARTTLS) ou 465 (TLS implícito, com SMTP_SECURE=true).
SMTP_PORT=587

# [opcional] true = TLS implícito desde a conexão (normalmente 465).
# false = conexão simples que passa a TLS por STARTTLS (normalmente 587).
SMTP_SECURE=false

# [opcional] Com SMTP_SECURE=false: true (padrão) recusa enviar se o servidor
# não oferecer STARTTLS, para a senha nunca trafegar em claro. false só para
# um relay interno sem TLS.
SMTP_REQUIRE_TLS=true

# [PRODUÇÃO: necessária se o servidor exigir autenticação] Usuário e senha
# juntos, ou nenhum dos dois.
SMTP_USER=
SMTP_PASSWORD=

# [PRODUÇÃO: necessária] Remetente dos e-mails.
SMTP_FROM=
# SMTP_FROM=Usina do Seguro <naoresponda@usina.example>
